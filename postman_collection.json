{
  "info": {
    "name": "Goal Tracker CRUD API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Read all goals",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/goals.php"
      }
    },
    {
      "name": "Read one goal",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/goals.php?id=1"
      }
    },
    {
      "name": "Create goal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Review API code\",\n  \"category\": \"School\",\n  \"term\": \"Short Term\",\n  \"status\": \"In Progress\",\n  \"notes\": \"Practice explaining each function.\"\n}"
        },
        "url": "{{base_url}}/goals.php"
      }
    },
    {
      "name": "Update goal",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Finish PHP CRUD API\",\n  \"category\": \"School\",\n  \"term\": \"Short Term\",\n  \"status\": \"Done\",\n  \"notes\": \"Ready for presentation.\"\n}"
        },
        "url": "{{base_url}}/goals.php"
      }
    },
    {
      "name": "Delete goal",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/goals.php?id=1"
      }
    }
  ]
}
